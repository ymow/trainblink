<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>TrainBlink</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>com.trainblink.app</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Location permissions for geofencing -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>TrainBlink needs your location to detect when you enter train stations and connect you with nearby users.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>TrainBlink uses your location in the background to automatically activate when you enter a train station.</string>

    <key>NSLocationAlwaysUsageDescription</key>
    <string>TrainBlink uses your location to detect train stations even when the app is in the background.</string>

    <!-- Local network for P2P -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>TrainBlink uses local network to connect with nearby users via Bluetooth and WiFi Direct.</string>

    <key>NSBonjourServices</key>
    <array>
        <string>_trainblink._tcp</string>
        <string>_trainblink._udp</string>
    </array>

    <!-- Bluetooth for P2P discovery -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>TrainBlink uses Bluetooth to discover and connect with nearby users.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>TrainBlink uses Bluetooth to connect with nearby users for peer-to-peer communication.</string>

    <!-- Camera and photo library access -->
    <key>NSCameraUsageDescription</key>
    <string>TrainBlink needs camera access to let you take photos to share with nearby users.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>TrainBlink needs access to your photo library to let you select photos to share.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>TrainBlink can save received photos to your library (with your permission).</string>

    <!-- Firebase specific -->
    <key>FirebaseScreenReportingEnabled</key>
    <false/>

    <key>FirebaseDataCollectionDefaultEnabled</key>
    <true/>

    <key>FirebaseAutomaticScreenReportingEnabled</key>
    <false/>
</dict>
</plist>
